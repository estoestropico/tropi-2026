# Salida del build (se regenera entera en cada build)
dist/
dist-previa/
.astro/

# Imágenes originales del sitio: la fuente única es la carpeta de la Mac.
# Se copian acá solo para hacer el build local; no se versionan.
src/assets/

# Dependencias
node_modules/
vendor/

# Referencias de diseño: no se versionan, salvo el robots de la previa,
# que usa `npm run build:previa`.
_ref/*
!_ref/robots-previa.txt
_check/
Claude outputs/
_duplicados-revisar/
_espejo.tgz
_e2.tgz

# Configuración / secretos (la config de Prometheo vive en tropi-privado/, fuera del repo)
.env
.env.*
*.key
*.pem

# Sistema / editores
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Logs, temporales y backups
*.log
*.tmp
*.bak
*.tar.gz
*.zip
*.sql
