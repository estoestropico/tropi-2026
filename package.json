{
  "name": "tropico-t26",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:limpio": "rm -rf .astro node_modules/.vite node_modules/.astro dist && astro dev --force",
    "build": "astro build && node scripts/verificar-contacto.mjs dist",
    "preview": "astro preview",
    "check": "astro check",
    "build:previa": "PREVIA=1 astro build --outDir dist-previa && cp _ref/robots-previa.txt dist-previa/robots.txt && node scripts/verificar-contacto.mjs dist-previa"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/big-shoulders": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
