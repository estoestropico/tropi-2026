---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { margenArriba, type Espacio } from '../../lib/espacios';

/**
 * Video de caso: autoplay silencioso en loop.
 * Si todavía no hay `src`, muestra el poster y marca el video como pendiente:
 * la estructura ya es la definitiva.
 *
 * efecto — igual que en Media: "reveal" | "fade" | "parallax" | "ninguno".
 */
export type Efecto = 'reveal' | 'fade' | 'parallax' | 'ninguno';

interface Props {
  alt: string;
  proporcion: string;
  efecto: Efecto;
  src?: string;
  poster?: string;
  posterImagen?: ImageMetadata;
  ancho?: 'completo' | 'contenido';
  /** Separación con el bloque anterior. Ver src/lib/espacios.ts */
  espacio?: Espacio;
  class?: string;
}

const {
  alt,
  proporcion,
  efecto,
  src,
  poster,
  posterImagen,
  ancho = 'contenido',
  espacio,
  class: className = '',
} = Astro.props;

const margen = margenArriba(espacio);

const conReveal = efecto === 'reveal' ? '' : undefined;
const conFade = efecto === 'fade' ? '' : undefined;
const seMueve = efecto === 'parallax';

/* Si el video se desplaza dentro del marco necesita la misma holgura que
   Media: 112 % de alto con 6 % de sobra de cada lado. */
/* La sobra de arriba va en `top` y no en `margin-top`: un margen porcentual
   se calcula contra el ancho y el alto de 112 % contra el alto, que en un
   marco apaisado no da la misma sobra arriba que abajo. Ver Media.astro. */
const claseMedia = seMueve
  ? 'absolute inset-x-0 top-[-6%] h-[112%] w-full object-cover'
  : 'h-full w-full object-cover';
---

<figure
  class:list={[
    'relative overflow-hidden bg-oscuro/5',
    ancho === 'contenido' ? '' : 'w-full',
    className,
  ]}
  style={[`aspect-ratio:${proporcion}`, margen].filter(Boolean).join(';')}
  data-mascara={conReveal}
  data-revelar={conFade}
  data-parallax-in={seMueve ? '0.10' : undefined}
>
  {
    src ? (
      <video
        class={claseMedia}
        src={src}
        poster={poster}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={alt}
      />
    ) : posterImagen ? (
      <>
        <Image
          src={posterImagen}
          alt={alt}
          widths={[360, 720, 1080]}
          sizes="(min-width: 1024px) 360px, 45vw"
          class={claseMedia}
        />
        <span class="absolute left-3 top-3 rounded-full bg-[#e5241d] px-2.5 py-1 text-[0.625rem] font-semibold uppercase tracking-[0.06em] text-white">
          Video pendiente
        </span>
      </>
    ) : (
      <span class="grid h-full w-full place-items-center text-[0.75rem] font-semibold uppercase tracking-[0.06em] text-[#e5241d]">
        Video pendiente
      </span>
    )
  }
</figure>

<script>
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (quieto.matches) {
    document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
      v.autoplay = false;
      v.controls = true;
      v.pause();
    });
  }
</script>
