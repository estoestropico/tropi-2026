---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  excluir: string;
  cantidad?: number;
}

const { excluir, cantidad = 3 } = Astro.props;

/* Los tres relacionados de cada caso, en orden. Los de Washington School,
   Farmaexpert y Puff los eligió Trópico; el resto está armado para que la
   cadena pase por todos los casos y nadie quede sin link desde otro. */
const RELACIONADOS: Record<string, string[]> = {
  'washington-school': ['farmaexpert', 'parisi', 'acadi'],
  farmaexpert: ['washington-school', 'fxm', 'fornaro'],
  puff: ['fornaro', 'farmaexpert', 'fxm'],
  acadi: ['puff', 'washington-school', 'fxm'],
  fxm: ['acadi', 'parisi', 'puff'],
  parisi: ['galarraga', 'fornaro', 'acadi'],
  fornaro: ['parisi', 'puff', 'acadi'],
  tao: ['washington-school', 'farmaexpert', 'parisi'],
  galarraga: ['parisi', 'washington-school', 'tao'],
};

const publicados = (await getCollection('casos'))
  .filter((c) => c.data.publicado && c.id !== excluir)
  .sort((a, b) => a.data.orden - b.data.orden);

/* Si el caso tiene lista, manda la lista; si no —un caso nuevo—, se completa
   con los publicados por orden, como antes. */
const elegidos = (RELACIONADOS[excluir] ?? [])
  .map((id) => publicados.find((c) => c.id === id))
  .filter((c): c is (typeof publicados)[number] => Boolean(c));
const casos = [...elegidos, ...publicados.filter((c) => !elegidos.includes(c))].slice(0, cantidad);

/* Misma máscara que las miniaturas de la home y del portfolio: cuadrada en
   reposo, con los lóbulos al pasar el mouse. */
const PLANA =
  'M1 0.25C1 0.25 1 0 1 0H0V0.5H0C0 0.5 0 0.75 0 0.75C0 0.75 0 1 0 1H1V0.5H1C1 0.5 1 0.25 1 0.25Z';
---

{
  casos.length > 0 && (
    <section class="otros py-20 lg:py-28">
      <div class="contenido">
        <h2
          class="rotulo rotulo-caso mb-10 flex items-center gap-3"
          data-revelar
        >
          Ver más proyectos
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M0 5h12M8.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
          </svg>
        </h2>

        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-revelar-grupo>
          {casos.map((caso) => (
            <li>
              <a href={`/casos/${caso.id}`} class="tarjeta group block">
                <div class="aspect-square overflow-hidden" style={`clip-path:url(#mascara-otros-${caso.id})`}>
                  <Image
                    src={caso.data.portada}
                    alt={caso.data.portadaAlt}
                    widths={[440, 640, 875]}
                    sizes="(min-width: 1024px) 452px, (min-width: 640px) 45vw, 90vw"
                    class="otros-img h-full w-full object-cover"
                  />
                </div>
                <svg width="0" height="0" aria-hidden="true" focusable="false" class="otros-mascara">
                  <defs>
                    <clipPath id={`mascara-otros-${caso.id}`} clipPathUnits="objectBoundingBox">
                      <path d={PLANA} />
                    </clipPath>
                  </defs>
                </svg>
                <p class="mt-4 text-[0.8125rem] uppercase tracking-[0.08em] text-oscuro/60">
                  {caso.data.cliente}
                </p>
                <p class="tarjeta-titular mt-1 text-[1.125rem] font-bold leading-tight tracking-[-0.02em]">
                  <span>{caso.data.titular}</span>
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .tarjeta-titular span {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size 600ms var(--ease-salida);
    padding-bottom: 2px;
  }

  .tarjeta:hover .tarjeta-titular span,
  .tarjeta:focus-visible .tarjeta-titular span {
    background-size: 100% 1px;
  }

  .otros-img {
    transition: transform 900ms var(--ease-salida);
  }

  /* El SVG de la máscara no ocupa lugar: sin esto sumaba su línea al alto
     de la tarjeta. */
  .otros-mascara {
    position: absolute;
  }

  .otros-mascara path {
    d: path('M1 0.25C1 0.25 1 0 1 0H0V0.5H0C0 0.5 0 0.75 0 0.75C0 0.75 0 1 0 1H1V0.5H1C1 0.5 1 0.25 1 0.25Z');
    transition: d 480ms cubic-bezier(0.45, 0.05, 0.25, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover .otros-mascara path,
    .tarjeta:focus-visible .otros-mascara path {
      d: path('M1 0.25C1 0.11183 0.89942 0 0.77573 0H0V0.5H0.22427C0.10032 0.5 0 0.61212 0 0.75C0 0.88817 0.10058 1 0.22427 1H0.99974V0.5H0.77547C0.89942 0.5 1 0.38788 1 0.25Z');
    }

    .tarjeta:hover .otros-img,
    .tarjeta:focus-visible .otros-img {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta-titular span,
    .otros-mascara path,
    .otros-img {
      transition: none;
    }
  }
</style>

<style>
  /* El arena sangra a los dos lados aunque el contenido esté topado en 1780 */
  .otros {
    position: relative;
    isolation: isolate;
  }
  .otros::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    background-color: var(--color-arena);
    z-index: -1;
  }
</style>
