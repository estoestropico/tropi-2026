---
import Banda from '../caso/Banda.astro';

/**
 * Bloque de preguntas frecuentes. Sale de la página de servicio, donde vivía
 * embebido; lo usan las páginas de servicio y las verticales de rubro.
 *
 * `respuestaHtml` permite links adentro de la respuesta. `oscuras` pasa el
 * bloque a la banda oscura, como en 360.
 */
interface Props {
  slug: string;
  preguntas: { pregunta: string; respuesta?: string; respuestaHtml?: string }[];
  oscuras?: boolean;
}

const { slug, preguntas: PREGUNTAS, oscuras = false } = Astro.props;

const ARENA = '#f5f4eb';
const OSCURO = '#050515';
---

<Banda color={oscuras ? OSCURO : ARENA} espacio="nulo" class={oscuras ? 'text-arena' : undefined}>
  <div class="contenido py-[80px] lg:py-[120px]" data-preguntas-oscuras={oscuras ? '' : undefined}>
    {/* El aqua es un color de fondo oscuro: sobre la banda arena no tiene
        contraste, así que ahí el rótulo va en violeta. */}
    <p class:list={['rotulo', oscuras ? 'text-aqua' : 'text-violeta']} data-revelar>
      ¿Tenés preguntas?
    </p>
    <div class="mt-8 lg:mt-[48px]">
      {
        PREGUNTAS.map((p) => (
          <details class="pregunta" name={`preguntas-${slug}`}>
            <summary>
              <span>{p.pregunta}</span>
              <span class="signo" aria-hidden="true" />
            </summary>
            <div class="respuesta-caja">
              {p.respuestaHtml ? <p class="respuesta" set:html={p.respuestaHtml} /> : <p class="respuesta">{p.respuesta}</p>}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Banda>

<style>
  /* ── Preguntas: el acordeón de la home, sobre arena ───────────────── */
  .pregunta {
    border-bottom: 1px solid rgb(5 5 21 / 0.45);
    /* Color del hover: sobre arena, magenta; sobre la banda oscura, amarillo. */
    --pregunta-hover: var(--color-rojo);
  }

  /* Sobre la banda oscura la línea se invierte, como en la home. El signo
     amarillo con las barras oscuras funciona igual en los dos fondos. */
  [data-preguntas-oscuras] .pregunta {
    border-bottom-color: rgb(245 244 235 / 0.35);
    --pregunta-hover: var(--color-amarillo);
  }

  .pregunta summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: color 180ms var(--ease-salida);
  }

  /* Hover sólo en las preguntas cerradas: pasan el texto y el signo al color
     del bloque. Abierta no cambia, así el color marca lo que queda por abrir. */
  .pregunta:not([open]) summary:hover,
  .pregunta[data-estado='cerrado'] summary:hover {
    color: var(--pregunta-hover);
  }

  .pregunta:not([open]) summary:hover .signo,
  .pregunta[data-estado='cerrado'] summary:hover .signo {
    --signo-tinta: var(--pregunta-hover);
  }

  .pregunta summary::-webkit-details-marker {
    display: none;
  }

  /* Signo del acordeón. Sobre fondo claro el círculo es oscuro al 20 % con
     las barras oscuras, y al abrir se llena de oscuro con la barra en arena.
     Sobre la banda oscura es el mismo juego al revés; lo cambia el bloque
     redefiniendo las cuatro variables. */
  .signo {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    --signo-fondo: rgb(5 5 21 / 0.1);
    --signo-tinta: var(--color-oscuro);
    --signo-fondo-abierto: var(--color-oscuro);
    --signo-tinta-abierta: var(--color-arena);
    background-color: var(--signo-fondo);
  }

  [data-preguntas-oscuras] .signo {
    --signo-fondo: rgb(245 244 235 / 0.1);
    --signo-tinta: var(--color-arena);
    --signo-fondo-abierto: var(--color-arena);
    --signo-tinta-abierta: var(--color-oscuro);
  }

  .signo::before,
  .signo::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1.5px;
    translate: -50% -50%;
    background-color: var(--signo-tinta);
    transition: background-color 240ms var(--ease-salida);
  }

  .signo {
    transition: background-color 240ms var(--ease-salida);
  }

  .signo::after {
    rotate: 90deg;
    transition: opacity 240ms var(--ease-salida);
  }

  /* El signo sigue al estado que maneja el script del acordeón y no al
     atributo `open`: al cerrar, `open` recién se va cuando termina la
     animación, y el signo cambiaba tarde, en un segundo tiempo. Sin JS,
     manda `open`. */
  .pregunta[open]:not([data-estado='cerrado']) .signo,
  .pregunta[data-estado='abierto'] .signo {
    background-color: var(--signo-fondo-abierto);
  }

  .pregunta[open]:not([data-estado='cerrado']) .signo::before,
  .pregunta[data-estado='abierto'] .signo::before {
    background-color: var(--signo-tinta-abierta);
  }

  .pregunta[open]:not([data-estado='cerrado']) .signo::after,
  .pregunta[data-estado='abierto'] .signo::after {
    opacity: 0;
  }

  .respuesta {
    max-width: 690px;
    padding-bottom: 24px;
    line-height: 1.4;
  }

  @media (width >= 64rem) {
    .pregunta summary {
      padding-block: 28px;
      font-size: 1.5rem;
    }

    .signo {
      width: 26px;
      height: 26px;
    }

    .signo::before,
    .signo::after {
      width: 12px;
    }

    .respuesta {
      padding-bottom: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signo::after {
      transition: none;
    }
  }
</style>

<script>
  /* Abren y cierran con transición, y abrir una cierra las demás. */
  import { iniciarAcordeon } from '../../scripts/acordeon';
  iniciarAcordeon();
</script>
