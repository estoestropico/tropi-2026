<script>
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Tiras que se corren en horizontal con el scroll: `p` va de 0 a 1
     mientras la tira cruza la pantalla y la pista recorre una copia entera.
     El sentido lo da `data-tira` (-1 hacia la izquierda, 1 hacia la
     derecha). La pista tiene tres copias y arranca en la del medio. */
  const tiras = [...document.querySelectorAll<HTMLElement>('[data-tira]')]
    .map((marco) => ({
      marco,
      pista: marco.querySelector<HTMLElement>('.tira-pista'),
      sentido: Number(marco.dataset.tira) || -1,
    }))
    .filter((t) => t.pista);

  /* Panel YANE: `--p` va de 0 cuando la celda asoma por abajo a 1 cuando
     su centro llega al centro de la pantalla. */
  const paneles = [...document.querySelectorAll<HTMLElement>('[data-panel]')];

  /* La home dentro de la Mac baja atada al scroll, como en FXM. */
  const macs = [...document.querySelectorAll<HTMLElement>('.web-mac')]
    .map((marco) => ({
      marco,
      mascara: marco.querySelector<HTMLElement>('.web-mac-pantalla'),
      home: marco.querySelector<HTMLElement>('.web-mac-home'),
    }))
    .filter((c) => c.mascara && c.home);

  if (!quieto) {
    let pendiente = false;

    const avance = (r: DOMRect, alto: number) =>
      Math.min(1, Math.max(0, 1 - (r.top + r.height) / (alto + r.height)));

    const pintar = () => {
      pendiente = false;
      const alto = window.innerHeight || 1;

      tiras.forEach((t) => {
        const r = t.marco.getBoundingClientRect();
        if (r.bottom < -alto * 0.25 || r.top > alto * 1.25) return;
        const copia = t.pista!.scrollWidth / 3;
        const p = avance(r, alto);
        /* Arranca un tercio adentro y recorre media copia: suficiente para
           que se lea el movimiento sin que se vea el borde de la pista. */
        const x = -copia + t.sentido * (p - 0.5) * copia * 0.5;
        t.pista!.style.transform = `translate3d(${x.toFixed(1)}px, 0, 0)`;
      });

      paneles.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < -alto * 0.25 || r.top > alto * 1.25) return;
        const p = Math.min(1, Math.max(0, (alto - r.top) / (alto / 2 + r.height / 2)));
        el.style.setProperty('--p', p.toFixed(3));
      });

      macs.forEach((c) => {
        const r = c.marco.getBoundingClientRect();
        if (r.bottom < -alto * 0.25 || r.top > alto * 1.25) return;
        const recorrido = c.home!.offsetHeight - c.mascara!.offsetHeight;
        if (recorrido <= 0) return;
        const demora = 0.15;
        const p = Math.min(1, Math.max(0, (avance(r, alto) - demora) / (1 - demora)));
        c.home!.style.transform = `translate3d(0, ${(-p * recorrido).toFixed(1)}px, 0)`;
      });
    };

    const alScrollear = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(pintar);
      }
    };

    window.addEventListener('scroll', alScrollear, { passive: true });
    window.addEventListener('resize', alScrollear, { passive: true });
    window.addEventListener('load', pintar);
    pintar();
  } else {
    paneles.forEach((el) => el.style.setProperty('--p', '1'));
    tiras.forEach((t) => {
      t.pista!.style.transform = `translate3d(${-t.pista!.scrollWidth / 3}px, 0, 0)`;
    });
  }
</script>
