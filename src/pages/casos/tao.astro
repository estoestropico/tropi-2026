import feedSiptao2 from '../../assets/casos/tao/feed-siptao-2.png';
import feedAcademy2 from '../../assets/casos/tao/feed-academy-2.png';
import feedAcademy3 from '../../assets/casos/tao/feed-academy-3.png';
import feedAcademy4 from '../../assets/casos/tao/feed-academy-4.png';
