/* Paleta. Las tres líneas de producto llevan una textura arriba y el color
   abajo, con el ícono del panel. */
const LINEAS = [
  { nombre: 'SIP-TAO', color: '#82d2e6', textura: texturaCielo, ico: icoSiptao, alt: 'Cielo' },
  { nombre: 'YANE-TAO', color: '#f4cd94', textura: texturaMadera, ico: icoYane, alt: 'Corte de tronco' },
  { nombre: 'INTERIA-TAO', color: '#a8d6b4', textura: texturaPasto, ico: icoInteria, alt: 'Pasto' },
