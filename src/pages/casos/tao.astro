import stand from '../../assets/casos/tao/stand.png';
import mac from '../../assets/casos/tao/mac.png';
import webHome from '../../assets/casos/tao/web-home.png';
import storyCelular from '../../assets/casos/tao/story-celular.png';
import storySantiago from '../../assets/casos/tao/story-santiago.png';
import feedConstruccion from '../../assets/casos/tao/feed-construccion.png';
import storySanMartin from '../../assets/casos/tao/story-san-martin.png';
