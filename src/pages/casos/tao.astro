/* Elementos gráficos de TAO. Posiciones del Figma relativas al bloque
   (x sobre 1780, y sobre un alto de 350). */
const ICONOS_TAO = [
  { src: icoHerramienta, alt: 'Ícono: herramienta', x: 255, y: 0, w: 149 },
  { src: icoCalendario, alt: 'Ícono: calendario', x: 479, y: 0, w: 149 },
  { src: icoCasaSustentable, alt: 'Ícono: casa sustentable', x: 703, y: 0, w: 149 },
  { src: icoResistente, alt: 'Sello: resistente, económico, sostenible, eficiente', x: 980, y: 0, w: 149 },
  { src: icoSustentable, alt: 'Sostenible y de alto rendimiento', x: 1203, y: 10, w: 169 },
  { src: icoPaneles, alt: 'Ícono: paneles', x: 1437, y: 5, w: 118 },
  { src: icoCorte, alt: 'Ícono: corte', x: 255, y: 201, w: 149 },
  { src: icoApilado, alt: 'Ícono: paneles apilados', x: 479, y: 201, w: 149 },
  { src: icoReciclado, alt: 'Ícono: reciclado', x: 703, y: 201, w: 149 },
  { src: icoDialogo, alt: 'Globo de diálogo', x: 980, y: 216, w: 167 },
  { src: icoBarras, alt: 'Barras', x: 1204, y: 252, w: 168 },
  { src: icoCasaCorazon, alt: 'Ícono: casa con corazón', x: 1445, y: 215, w: 102 },
];

/* Merchandising: cinco piezas sueltas, alto de bloque 358. */
const MERCH = [
  { src: merchGorra, alt: 'Gorra de TAO', x: 221, y: 28, w: 283 },
  { src: merchLapices, alt: 'Lápices de madera de TAO', x: 531, y: 46, w: 202 },
  { src: merchChomba, alt: 'Chomba de TAO', x: 751, y: 0, w: 358 },
  { src: merchMate, alt: 'Mate de madera con la marca TAO', x: 1083, y: 48, w: 250 },
  { src: merchLanyard, alt: 'Cinta porta credencial de TAO', x: 1327, y: 59, w: 288 },
];

/* Fichas técnicas. En el Figma la tira arranca cortada contra los dos
   bordes; acá van las cinco fichas enteras y la tira se repite. */
const FICHAS = [
  { src: ficha2, alt: 'Ficha técnica: paneles SIP' },
  { src: ficha3, alt: 'Ficha técnica: prediseño de vivienda' },
  { src: ficha4, alt: 'Ficha técnica: revestimiento interior INTERIA' },
  { src: ficha5, alt: 'Ficha técnica: descripción de productos' },
  { src: ficha6, alt: 'Ficha técnica: techos YANE' },
];

/* Mosaico de redes sobre el malva: el celular y la grilla de piezas, con
   las posiciones del Figma sobre 1780 × 731. Las dos piezas que faltan
   exportar van como placeholder en su lugar. */
const MOSAICO = [
  { src: storyCelular, alt: 'Story de TAO en el celular', x: 50, y: 0, w: 340 },
  { src: storySantiago, alt: 'Story: nuevo TAO Point Santiago del Estero', x: 429, y: 4, w: 252 },
  { src: feedConstruccion, alt: 'Posteo: construcción con madera', x: 691, y: 4, w: 252 },
  { src: storySanMartin, alt: 'Story: nuevo TAO Point San Martín', x: 691, y: 266, w: 252 },
  { src: storyAgradecimiento, alt: 'Story: fue una mañana muy constructiva', x: 952, y: 4, w: 252 },
  { src: feedInteria, alt: 'Posteo: paneles INTERIA-TAO', x: 953, y: 462, w: 252 },
  { src: feedChapadmalal, alt: 'Posteo: sostenibilidad frente al mar', x: 1214, y: 4, w: 252 },
  { src: storyMadryn, alt: 'Story: nuevo TAO Point Puerto Madryn', x: 1215, y: 266, w: 252 },
  { src: storyQueresSip, alt: 'Story: ¿querés construir tu vivienda?', x: 1477, y: 4, w: 252 },
  { src: feedSiptao1, alt: 'Posteo: SIP-TAO, optimización de recursos', x: 429, y: 461, w: 253 },
  { src: feedSiptao2, alt: 'Posteo: construimos con madera, derribamos mitos', x: 1477, y: 461, w: 253 },
];


/* Paleta de TAO Academy: anchos del Figma sobre 1780. */
const PALETA_ACADEMY = [
  { nombre: 'Pantone 1655 C', hex: '#ED5B29', fondo: '#ed5b29', tinta: '#ffffff', ancho: 453 },
  { nombre: 'Blanco puro', hex: '#FFFFFF', fondo: '#ffffff', tinta: '#000000', ancho: 452 },
  { nombre: 'Black 6 C', hex: '#111821', fondo: '#000000', tinta: '#ffffff', ancho: 292 },
  { nombre: 'Pantone 7632 C', hex: '#D2C8CB', fondo: '#d2c8cb', tinta: '#000000', ancho: 291 },
  { nombre: 'Pantone 436 C', hex: '#AC9EA2', fondo: '#ac9ea2', tinta: '#ffffff', ancho: 292 },
];

/* Elementos gráficos de TAO Academy, alto de bloque 361. */
const ICONOS_ACADEMY = [
  { src: icoBirrete, alt: 'Ícono: birrete', x: 129, y: 0, w: 154 },
  { src: icoClaseOnline, alt: 'Ícono: clase online', x: 360, y: 0, w: 154 },
  { src: icoReloj, alt: 'Ícono: reloj', x: 591, y: 0, w: 154 },
  { src: academyPuntos, alt: 'Trama de puntos', x: 905, y: 34, w: 96 },
  { src: academyCuadrados, alt: 'Cuadrados superpuestos', x: 1087, y: 26, w: 160 },
  { src: academyCirculo, alt: 'Círculo punteado', x: 1342, y: 25, w: 120 },
  { src: academyFlechas, alt: 'Flechas', x: 1555, y: 32, w: 99 },
  { src: icoUbicacion, alt: 'Ícono: ubicación', x: 129, y: 207, w: 154 },
  { src: icoDocente, alt: 'Ícono: docente', x: 360, y: 207, w: 154 },
  { src: icoCurso, alt: 'Ícono: curso', x: 591, y: 207, w: 154 },
  { src: academyCarpeta, alt: 'Carpeta', x: 905, y: 210, w: 186 },
  { src: academySuma, alt: 'Sumá conocimiento', x: 1152, y: 229, w: 215 },
  { src: academyInscribite, alt: 'Inscribite', x: 1428, y: 248, w: 227 },
];

/* Feed de TAO Academy. Van las cuatro piezas enteras; las dos de los
   extremos vienen recortadas en el export y quedan afuera de la tira. */
const FEED_ACADEMY = [
  { src: feedAcademy2, alt: 'Posteo: capacitación en la UOCRA, Mar del Plata' },
  { src: feedAcademy3, alt: 'Posteo: ¿querés construir mejor y más rápido?' },
  { src: feedAcademy4, alt: 'Posteo: obra abierta de TAO Academy' },
  { src: feedAcademy5, alt: 'Posteo: capacitación en sistema constructivo SIP-TAO' },
];

---

<Base titulo={`${data.cliente} · Caso`} descripcion={data.metaDescripcion ?? data.bajada ?? data.titular}>
  <CasoHero
    cliente={data.cliente}
    titular={data.titular}
    rubro={data.rubro}
    servicios={data.servicios}
    imagen={hero}
    imagenAlt={data.heroAlt ?? data.cliente}
    solape={0}
  />

  <Intro espacio="l">
    TAO Soluciones Constructivas es una empresa especializada en el sistema
    constructivo SIP: fabrican paneles, los mecanizan y comercializan kits
    integrales de obra. Nuestro trabajo consistió en ordenar su comunicación
    marcaria desde los cimientos. Tras el desarrollo integral, les entregamos
    los manuales de marca y herramientas clave para que su equipo interno
    tenga autonomía y pueda darle continuidad a la comunicación.
  </Intro>

  {/* ── Revamp marcario ─────────────────────────────────────────────────── */}
  <BloqueTexto espacio="l" etiqueta="Estrategia e identidad" titulo="Revamp marcario y arquitectura de marca">
    <p>
      Ejecutamos un revamp de la identidad para evolucionar su discurso y dejar
      de hablar exclusivamente de "paneles", posicionándolos como referentes en
      soluciones integrales. Ordenamos su arquitectura de marca —que presentaba
      cierta dispersión inicial— y desarrollamos sus mensajes de venta para
      estructurar una narrativa comercial más sólida.
    </p>

    {/* La marca anterior y la nueva, lado a lado. La anterior no está
        exportada todavía. */}
    <div slot="derecha" class="mt-10 flex items-center gap-10 lg:mt-[60px] lg:gap-[135px]" data-revelar-grupo>
      <div class="w-[28%] max-w-[225px]">
        <Image src={marcaAnterior} alt="Marca anterior de TAO: vanguardia en paneles" class="h-auto w-full" />
      </div>
      <div class="w-[48%] max-w-[394px]">
        <Image src={logoTao} alt="TAO Soluciones Constructivas" class="h-auto w-full" />
      </div>
    </div>
  </BloqueTexto>

  {/* ── Arquitectura monolítica ─────────────────────────────────────────── */}
  <Banda color={AZUL} espacio="m" class="arquitectura text-white">
    <div class="contenido py-16 lg:py-[79px]">
      <div class="arq-titulo" data-revelar>
        <span class="arq-llave" aria-hidden="true"></span>
        <h2 class="arq-rotulo">Arquitectura monolítica</h2>
        <span class="arq-llave arq-llave-der" aria-hidden="true"></span>
      </div>

      <ul class="arq-marcas" data-revelar-grupo>
        {
          ARQUITECTURA.map((m) => (
            <li class="arq-marca">
              <div class="arq-logo">
                <Image src={m.logo} alt={m.alt} class="h-auto w-full" style={`max-width:${m.ancho}px`} />
              </div>
              <span class="arq-punteado" aria-hidden="true" />
              <svg class="arq-icono" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                {m.icono === 'casa' && <path d="M8 58V28L32 6l24 22v30H8Z" stroke-linejoin="round" />}
                {m.icono === 'pin' && (
                  <>
                    <path d="M32 46s-14-11-14-22a14 14 0 0 1 28 0c0 11-14 22-14 22Z" />
                    <circle cx="32" cy="24" r="6" />
                    <path d="M20 58h24M32 46v12" />
                  </>
                )}
                {m.icono === 'paneles' && (
                  <>
                    <path d="M2 4h14v56H2zM5 6v52" />
                    <path d="M25 4h14v56H25zM28 6v52" />
                    <path d="M48 4h14v56H48z" />
                  </>
                )}
                {m.icono === 'birrete' && (
                  <>
                    <path d="M2 24 32 12l30 12-30 12L2 24Z" stroke-linejoin="round" />
                    <path d="M14 29v14c0 4 8 8 18 8s18-4 18-8V29" />
                    <path d="M56 26v18" />
                    <rect x="53" y="44" width="6" height="10" rx="2" />
                  </>
                )}
              </svg>
              <p class="arq-texto">{m.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Banda>

  {/* Paneles y cartel de obra. El panel animado está pendiente: en el Figma
      dice "GIF como la web". */}
  <Grilla cols="697fr 1070fr" gap="0.5625rem" class="mt-[9px]">
    <div class="grid place-items-center" style={`background-color:${GRIS_CLARO};aspect-ratio:697/650`}>
      {/* Las tres capas del panel YANE se juntan a medida que se scrollea:
          arrancan separadas en diagonal y terminan armando el panel. */}
      <div class="panel" data-panel aria-label="Panel YANE-TAO: placa, núcleo y placa" role="img">
        <Image src={yaneRight} alt="" class="panel-capa panel-der" />
        <Image src={yaneCenter} alt="" class="panel-capa panel-centro" />
        <Image src={yaneLeft} alt="" class="panel-capa panel-izq" />
      </div>
    </div>
    <Media efecto="reveal" src={cartelObra} alt="Cartel de obra: tecnología SIP-TAO en acción" proporcion="1070/650" />
  </Grilla>

  {/* ── Paleta ──────────────────────────────────────────────────────────── */}
  <section class="paleta full-width" aria-label="Paleta cromática de TAO">
    <div class="paleta-fila" style="--cols:1326fr 442fr">
      <div class="tono" style={`background-color:${AZUL};color:#ffffff`} data-revelar>
        <div>
          <p>Color Principal</p>
          <p class="font-bold">Pantone 3597 C</p>
        </div>
      </div>
      <div class="tono" style={`background-color:${LILA};color:${AZUL}`} data-revelar>
        <div>
          <p>Acento</p>
          <p class="font-bold">Pantone 264 C</p>
        </div>
      </div>
    </div>
    <div class="paleta-fila" style="--cols:1fr 1fr">
      <div class="tono" style={`background-color:${MALVA};color:${AZUL}`} data-revelar>
        <div>
          <p>Color Secundario</p>
          <p class="font-bold">Pantone 7632 C</p>
        </div>
      </div>
      <div class="tono" style={`background-color:${GRIS_CLARO};color:${AZUL}`} data-revelar>
        <div>
          <p>Color Secundario</p>
          <p class="font-bold">#F6F6F6</p>
        </div>
      </div>
    </div>
    <div class="paleta-fila paleta-lineas" style="--cols:586fr 586fr 584fr">
      {
        LINEAS.map((l) => (
          <div class="linea" data-revelar>
            <Image src={l.textura} alt={l.alt} widths={[400, 800, 1200]} sizes="(min-width: 1024px) 33vw, 100vw" class="linea-textura" />
            <div class="tono" style={`background-color:${l.color};color:${AZUL}`}>
              <div class="linea-texto">
                <p>{l.nombre}</p>
                <p class="linea-pantone font-bold">
                  Pantone 7632 C
                  <Image src={l.ico} alt="" aria-hidden="true" class="linea-ico" />
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── Elementos gráficos ──────────────────────────────────────────────── */}
  <BloqueTexto espacio="m" etiqueta="Universo visual" titulo="Sistema gráfico y diseño de la información">
    <p>
      Generamos un ecosistema visual amplio, versátil y atractivo, pensado
      específicamente para organizar un caudal de información denso. El
      sistema permite comunicar las múltiples facetas de la empresa, logrando
      un equilibrio exacto entre la necesidad de vender y el gran desafío de
      educar al mercado sobre un método constructivo relativamente nuevo en
      Argentina.
    </p>
  </BloqueTexto>

  <Composicion alto={350} colsMobile={3} espacio="m" alinear="figma" class="px-5 lg:px-0">
    {ICONOS_TAO.map((i) => <Pieza src={i.src} alt={i.alt} x={i.x} y={i.y} w={i.w} alto={350} />)}
  </Composicion>

  <Composicion alto={358} colsMobile={3} espacio="m" alinear="figma" class="px-5 lg:px-0">
    {MERCH.map((i) => <Pieza src={i.src} alt={i.alt} x={i.x} y={i.y} w={i.w} alto={358} />)}
