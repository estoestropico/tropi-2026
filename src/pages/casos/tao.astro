const caso = await getEntry('casos', 'tao');
if (!caso) throw new Error('Falta src/content/casos/tao.yaml');
const { data } = caso;

/* Colores muestreados del export del Figma (Tao.png). Todos en hex: el azul
   es fondo oscuro y no lleva display-p3. */
const AZUL = '#0f3775';
const LILA = '#c1a6e2';
const GRIS_CLARO = '#f6f6f6';
const MALVA = '#ddd6d8';

/* Arquitectura de marca: las cuatro marcas y lo que representa cada una. */
const ARQUITECTURA = [
  { logo: arqSoluciones, alt: 'TAO Soluciones Constructivas', ancho: 267, texto: 'Marca principal', icono: 'casa' },
  { logo: arqPoint, alt: 'TAO Point', ancho: 188, texto: 'Puntos comerciales', icono: 'pin' },
  { logo: arqYane, alt: 'TAO Yane', ancho: 174, texto: 'Línea de producto', icono: 'paneles' },
  { logo: arqAcademy, alt: 'TAO Academy', ancho: 245, texto: 'Extensión educativa', icono: 'birrete' },
