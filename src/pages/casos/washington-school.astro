<style>
  /* Tira de programas: las seis piezas en una sola fila, con el ancho en
     porcentaje del marco de grilla y el sobrante repartido en cinco
     separaciones iguales. Una sola regla para todos los anchos: la fila
     entera se achica junto con la grilla, igual que hacía el SVG único que
     había antes. */
  .tira-programas {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tira-programas > * {
    flex: none;
    width: var(--pl-ancho);
  }

  /* Pie de Washington School. La trama es un mosaico de 594 × 298 que se
     repite en vertical contra el borde izquierdo, escalado al alto del
     bloque: ocupa el tercio izquierdo y el resto queda liso. */
  .ws-pie {
    position: relative;
    aspect-ratio: 1780 / 298;
    background-color: #002d7d;
    background-image: var(--ws-trama);
    background-repeat: repeat-y;
    background-position: left top;
    background-size: auto 100%;
  }

  .ws-pie-marca {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 32.079%; /* 571 de 1780 */
    transform: translate(-50%, -50%);
  }

  .ws-pie-barra {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 27.697%; /* 493 de 1780 */
    height: 7.047%; /* 21 de 298 */
  }

  /* Tira cromática. Mantiene la proporción del diseño y crece con el ancho;
     el mínimo evita que quede como un hilo en pantallas chicas. */
  .tira {
    display: grid;
    grid-template-columns: 25fr 20fr 15fr 15fr 10fr 5fr 5fr 5fr;
    aspect-ratio: 1780 / 50;
    min-height: 1.75rem;
  }
</style>
