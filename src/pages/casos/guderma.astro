---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BloqueTexto from '../../components/caso/BloqueTexto.astro';
import CasoHero from '../../components/caso/CasoHero.astro';
import Grilla from '../../components/caso/Grilla.astro';
import Intro from '../../components/caso/Intro.astro';
import Media from '../../components/caso/Media.astro';
import MosaicoFeed from '../../components/caso/MosaicoFeed.astro';
import OtrosProyectos from '../../components/caso/OtrosProyectos.astro';
import TiraDoble from '../../components/caso/TiraDoble.astro';
import type { ImageMetadata } from 'astro';
import { margenArriba } from '../../lib/espacios';

import hero from '../../assets/casos/guderma/hero.png';
import bandaMarca from '../../assets/casos/guderma/banda-marca.png';
import logoGuderma from '../../assets/casos/guderma/logo-guderma.svg';
import bataProductos from '../../assets/casos/guderma/bata-productos.png';
import neceser from '../../assets/casos/guderma/neceser.png';
import etiquetaSerum from '../../assets/casos/guderma/etiqueta-serum.png';
import aguaMicelar from '../../assets/casos/guderma/agua-micelar.png';
import limpiador from '../../assets/casos/guderma/limpiador.png';
import lecheLimpieza from '../../assets/casos/guderma/leche-limpieza.png';
import contornoAplicado from '../../assets/casos/guderma/contorno-aplicado.png';
import contornoPote from '../../assets/casos/guderma/contorno-pote.png';
import estandarte from '../../assets/casos/guderma/estandarte.png';
import exhibidor from '../../assets/casos/guderma/exhibidor.png';
import vidriera from '../../assets/casos/guderma/vidriera.png';
import estante from '../../assets/casos/guderma/estante.png';
import farmacia from '../../assets/casos/guderma/farmacia.png';
import canasto from '../../assets/casos/guderma/canasto.png';
import cierreClaim from '../../assets/casos/guderma/cierre-claim.png';

import lineaBrumas from '../../assets/casos/guderma/linea-brumas.svg';
import lineaSerums from '../../assets/casos/guderma/linea-serums.svg';
import lineaHigiene from '../../assets/casos/guderma/linea-higiene.svg';
import lineaDia from '../../assets/casos/guderma/linea-dia.svg';
import lineaNoche from '../../assets/casos/guderma/linea-noche.svg';
import lineaOjos from '../../assets/casos/guderma/linea-ojos.svg';
import lineaLabial from '../../assets/casos/guderma/linea-labial.svg';
import lineaSolar from '../../assets/casos/guderma/linea-solar.svg';
import lineaMasculina from '../../assets/casos/guderma/linea-masculina.svg';

import manual1 from '../../assets/casos/guderma/manual-1.png';
import manual2 from '../../assets/casos/guderma/manual-2.png';
import manual3 from '../../assets/casos/guderma/manual-3.png';
import manual4 from '../../assets/casos/guderma/manual-4.png';
import manual5 from '../../assets/casos/guderma/manual-5.png';
import manual6 from '../../assets/casos/guderma/manual-6.png';
import manual7 from '../../assets/casos/guderma/manual-7.png';
import manual8 from '../../assets/casos/guderma/manual-8.png';

import feed1 from '../../assets/casos/guderma/post/feed-01.png';
import feed2 from '../../assets/casos/guderma/post/feed-02.png';
import feed3 from '../../assets/casos/guderma/post/feed-03.png';
import feed4 from '../../assets/casos/guderma/post/feed-04.png';
import feed5 from '../../assets/casos/guderma/post/feed-05.png';
import feed6 from '../../assets/casos/guderma/post/feed-06.png';
import feed7 from '../../assets/casos/guderma/post/feed-07.png';
import feed8 from '../../assets/casos/guderma/post/feed-08.png';
import feed9 from '../../assets/casos/guderma/post/feed-09.png';
import feed10 from '../../assets/casos/guderma/post/feed-10.png';
import feed11 from '../../assets/casos/guderma/post/feed-11.png';
import feed12 from '../../assets/casos/guderma/post/feed-12.png';
import feed13 from '../../assets/casos/guderma/post/feed-13.png';
import feed14 from '../../assets/casos/guderma/post/feed-14.png';
import feed15 from '../../assets/casos/guderma/post/feed-15.png';
import feed16 from '../../assets/casos/guderma/post/feed-16.png';
import feed17 from '../../assets/casos/guderma/post/feed-17.png';
import feed18 from '../../assets/casos/guderma/post/feed-18.png';

const caso = await getEntry('casos', 'guderma');
if (!caso) throw new Error('Falta src/content/casos/guderma.yaml');
const { data } = caso;

/* Colores muestreados del export del Figma */
const AQUA = '#a4dfd3';
const VIOLETA = '#402b56';

/* Sistema de líneas: cada familia de producto tiene su color de base, su
   logotipo y, abajo, los tonos que completan esa línea. Los valores salen del
   Figma del caso; el bloque se arma con divs, no con una captura, para que
   escale y se lea en cualquier ancho. */
const LINEAS = [
  { nombre: 'Brumas faciales', fondo: '#a4dfd3', logo: lineaBrumas, tonos: ['#69c9ba', '#008995', '#00945e', '#00af41'] },
  { nombre: 'Sérums', fondo: '#72d0eb', logo: lineaSerums, tonos: ['#2fc0e2', '#4a94ff', '#2c5f9e'] },
  { nombre: 'Higiene facial', fondo: '#7f56c5', logo: lineaHigiene, tonos: ['#c7b4e1', '#62269e', '#430098'] },
  { nombre: 'Facial día', fondo: '#f678c4', logo: lineaDia, tonos: ['#dd2497', '#d50053'] },
  { nombre: 'Facial noche', fondo: '#8294dc', logo: lineaNoche, tonos: [] },
  { nombre: 'Contorno de ojos', fondo: '#c29add', logo: lineaOjos, tonos: ['#8431a6', '#ce27af'] },
  { nombre: 'Cuidado labial', fondo: '#e0a46d', logo: lineaLabial, tonos: [] },
  { nombre: 'Protección solar', fondo: '#ffd100', logo: lineaSolar, tonos: [] },
  { nombre: 'Línea masculina', fondo: '#402b56', logo: lineaMasculina, tonos: ['#c29add', '#7f56c5', '#f678c4', '#a4dfd3', '#72d0eb'] },
];

/* Mosaico de feed: la grilla se inclina, se recorta con la máscara del
   sistema y las columnas se cruzan al scrollear. Mismo tratamiento que
   Fornaro. Las piezas que se repiten caen siempre en otra columna que su
   primera aparición, así no se ven dos iguales una al lado de la otra. */
const A = 'Pieza de contenido de Guderma';
const p = (src: ImageMetadata) => ({ src, alt: A, ratio: `${src.width}/${src.height}` });
const COLUMNAS_FEED = [
  { offset: '-14%', velocidad: -1, piezas: [p(feed1), p(feed7), p(feed13), p(feed4)] },
  { offset: '-26%', velocidad: 1, piezas: [p(feed2), p(feed8), p(feed14), p(feed10)] },
  { offset: '-19%', velocidad: -1, piezas: [p(feed3), p(feed9), p(feed15), p(feed6)] },
  { offset: '-31%', velocidad: 1, piezas: [p(feed4), p(feed10), p(feed16), p(feed1)] },
  { offset: '-16%', velocidad: -1, piezas: [p(feed5), p(feed11), p(feed17), p(feed2)] },
  { offset: '-24%', velocidad: 1, piezas: [p(feed6), p(feed12), p(feed18), p(feed3)] },
];

---

<Base titulo={`${data.cliente} · Caso`} descripcion={data.metaDescripcion ?? data.bajada ?? data.titular}>
  <CasoHero
    cliente={data.cliente}
    titular={data.titular}
    rubro={data.rubro}
    servicios={data.servicios}
    imagen={hero}
    imagenAlt={data.heroAlt ?? data.cliente}
  />

  <Intro espacio="l">
    Guderma es una línea de dermocosmética que se vende en farmacia. La marca
    tiene que explicar en la góndola qué resuelve cada producto, para qué tipo
    de piel es y en qué momento de la rutina se usa.
  </Intro>

  {/* ── Identidad ───────────────────────────────────────────────────────── */}
  <BloqueTexto espacio="m" etiqueta="La identidad" titulo="Una marca que explica antes de vender">
    <p>
      El sistema visual se apoya en una tipografía de lectura directa, espacios
      amplios y una jerarquía fija para los datos de cada pieza. El claim
      acompaña a la marca en todas sus aplicaciones.
    </p>
  </BloqueTexto>

  <section class="marca full-width" style={margenArriba('m')} data-revelar>
    <Image src={bandaMarca} alt="" aria-hidden="true" class="marca-fondo" />
    <Image src={logoGuderma} alt="Marca Guderma" class="marca-logo" />
  </section>

  {/* ── Sistema de líneas ───────────────────────────────────────────────── */}
  <BloqueTexto espacio="m" etiqueta="Sistema de líneas" titulo="Un color para cada necesidad">
    <p>
      La oferta se ordena en familias y cada una tiene su color, su logotipo y
      su gama de apoyo. El color identifica la familia en el envase y en la
      góndola, y el sistema admite líneas nuevas sin rehacer las anteriores.
    </p>
  </BloqueTexto>

  <section class="lineas full-width" style={margenArriba('m')} aria-label="Sistema de líneas de Guderma" data-revelar-grupo>
    {
      LINEAS.map((l) => (
        <article class="linea" style={`background-color:${l.fondo}`} data-revelar>
          <div class="linea-cuerpo">
            <p class="linea-nombre">{l.nombre}</p>
            <Image src={l.logo} alt="" aria-hidden="true" class="linea-logo" />
          </div>
          {l.tonos.length > 0 && (
            <div class="linea-tonos">
              {l.tonos.map((t) => (
                <span style={`background-color:${t}`} />
              ))}
            </div>
          )}
        </article>
      ))
    }
  </section>

  {/* Las dos fotos llevan la pastilla de la línea apoyada abajo a la izquierda. */}
  <Grilla class="full-width" cols="1fr 1fr" gap="0.65rem" espacio="m">
    <figure class="foto">
      <Media efecto="reveal" src={bataProductos} alt="Rutina completa de la línea facial" proporcion="760/884" />
      <figcaption class="pastilla" style={`background-color:${AQUA};color:${VIOLETA}`}>Línea completa</figcaption>
    </figure>
    <figure class="foto">
      <Media efecto="reveal" src={neceser} alt="Producto de la línea masculina" proporcion="760/884" />
      <figcaption class="pastilla" style={`background-color:${VIOLETA};color:#fff`}>Línea masculina</figcaption>
    </figure>
  </Grilla>

  {/* ── Packaging ───────────────────────────────────────────────────────── */}
  <BloqueTexto espacio="m" etiqueta="Packaging" titulo="El envase como primera explicación">
    <p>
      Cada etiqueta ordena la marca, la línea, el activo que la define y el modo
      de uso. La información obligatoria y la de uso conviven en la misma cara,
      con el color de la familia como primera referencia.
    </p>
  </BloqueTexto>

  <Grilla class="full-width" cols="1fr 1fr 1fr 1fr 1fr" gap="0.65rem" espacio="m">
    <Media efecto="reveal" src={aguaMicelar} alt="Agua micelar de la línea de higiene" proporcion="1/1" />
    <Media efecto="reveal" src={limpiador} alt="Limpieza facial en uso" proporcion="1/1" />
    <Media efecto="reveal" src={lecheLimpieza} alt="Leche de limpieza de la línea de higiene" proporcion="1/1" />
    <Media efecto="reveal" src={contornoAplicado} alt="Contorno de ojos en uso" proporcion="1/1" />
    <Media efecto="reveal" src={contornoPote} alt="Contorno de ojos de la línea facial" proporcion="1/1" />
  </Grilla>

  <Grilla class="full-width" cols="1fr 1fr" gap="0.65rem" espacio="xs">
    <Media efecto="reveal" src={estandarte} alt="Producción de producto para comunicación" proporcion="884/628" />
    <Media efecto="reveal" src={etiquetaSerum} alt="Diseño de etiqueta de un sérum de la línea" proporcion="884/628" />
  </Grilla>

  {/* ── Punto de venta ──────────────────────────────────────────────────── */}
  <BloqueTexto espacio="m" etiqueta="Punto de venta" titulo="De la góndola a la vidriera">
    <p>
      El sistema baja al local en exhibidores, material de mostrador y gráfica
      de vidriera. Las piezas están pensadas para una farmacia que exhibe
      muchas marcas a la vez y tiene su propio orden.
    </p>
  </BloqueTexto>

  <Grilla class="full-width" cols="1fr 1fr 1fr" gap="0.65rem" espacio="m">
    <Media efecto="reveal" src={exhibidor} alt="Exhibidor de la línea de contorno de ojos" proporcion="586/791" />
    <Media efecto="reveal" src={vidriera} alt="Gráfica de vidriera de una acción comercial" proporcion="586/791" />
    <Media efecto="reveal" src={estante} alt="La línea completa en la góndola" proporcion="586/791" />
  </Grilla>

  {/* Las ocho páginas del manual, sueltas: cuatro por fila. Las dos filas
      cruzan en sentidos opuestos al scrollear, como en los demás casos. */}
  <TiraDoble
    espacio="m"
    fondo="#ffffff"
    filas={[
      {
        piezas: [
          { src: manual1, alt: 'Páginas del manual de marca de Guderma' },
          { src: manual2 },
          { src: manual3 },
          { src: manual4 },
        ],
        sentido: -1,
        traba: -34,
      },
      {
        piezas: [
          { src: manual5, alt: 'Más páginas del manual de marca de Guderma' },
          { src: manual6 },
          { src: manual7 },
          { src: manual8 },
        ],
        sentido: 1,
        traba: -52,
      },
    ]}
  />

  <div class="contenido" style={margenArriba('m')}>
    <Media efecto="reveal" src={farmacia} alt="Frente de farmacia con la gráfica de la marca" proporcion="1530/867" />
  </div>

  {/* ── Contenido ───────────────────────────────────────────────────────── */}
  <BloqueTexto espacio="m" etiqueta="Contenido y comunidad" titulo="Divulgación con respaldo profesional">
    <p>
      El plan combina contenido de divulgación —cómo funciona la piel, qué hace
      cada activo— con las piezas del calendario comercial de la farmacia. Los
      dos registros usan el mismo sistema gráfico.
    </p>
  </BloqueTexto>

  <MosaicoFeed
    class="full-width"
    columnas={COLUMNAS_FEED}
    cols={6}
    inclinacion={-10}
    proporcion="1780/1134"
    proporcionBase="1780/1600"
    gap="24px"
    relleno="0px"
    fondo={VIOLETA}
    recorrido={130}
    espacio="m"
  />

  {/* Cierre: la foto se apoya sobre la franja aqua, que asoma abajo. */}
  <section class="cierre full-width" style={margenArriba('m')}>
    <div class="cierre-franja" style={`background-color:${AQUA}`} aria-hidden="true" />
    <div class="contenido relative">
      <Media efecto="reveal" src={canasto} alt="Producción de producto para campaña" proporcion="1530/721" />
    </div>
  </section>

  <Media class="full-width" efecto="fade" src={cierreClaim} alt="Pieza de cierre con el claim de la marca" proporcion="1780/478" />

  <OtrosProyectos excluir="guderma" />
</Base>

<style>
  /* Banda de marca: la textura va a sangre y el logotipo se apoya encima,
     centrado, al 40 % del ancho como en el Figma. */
  .marca {
    position: relative;
    display: grid;
    place-items: center;
  }

  .marca-fondo {
    width: 100%;
    height: auto;
    display: block;
  }

  .marca-logo {
    position: absolute;
    width: 48%;
    height: auto;
  }

  @media (width >= 64rem) {
    .marca-logo {
      width: 34%;
    }
  }

  /* Pastilla de línea sobre la foto. */
  .foto {
    position: relative;
  }

  .pastilla {
    position: absolute;
    bottom: 16px;
    left: 16px;
    border-radius: 999px;
    padding: 0.5rem 1.125rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (width >= 64rem) {
    .pastilla {
      bottom: 28px;
      left: 28px;
      padding: 0.65rem 1.5rem;
      font-size: 0.9375rem;
    }
  }

  /* Cierre: la franja arranca a media foto y sigue por debajo. */
  .cierre {
    position: relative;
  }

  .cierre-franja {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 62%;
  }

  /* Tres columnas en desktop, como en el Figma; dos y una al achicar. Cada
     tarjeta guarda la proporción 502 × 175 del diseño y la tira de tonos se
     apoya en el borde de abajo. */
  .lineas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    padding-inline: 20px;
  }

  @media (width >= 40rem) {
    .lineas {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (width >= 64rem) {
    .lineas {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.75rem;
      padding-inline: max(20px, calc((100% - 1530px) / 2));
    }
  }

  .linea {
    display: flex;
    /* El nombre va siempre en blanco, sobre cualquiera de los nueve fondos. */
    color: #fff;
    aspect-ratio: 502 / 175;
    flex-direction: column;
    justify-content: space-between;
  }

  .linea-cuerpo {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
  }

  /* El ancho corto es lo que parte el nombre en dos líneas, como en el Figma:
     la tipografía no se achica, se achica la caja. */
  .linea-nombre {
    max-width: 47%;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .linea-logo {
    width: auto;
    max-height: 68%;
    flex: none;
  }

  .linea-tonos {
    display: flex;
    height: 10px;
  }

  .linea-tonos span {
    flex: 1;
  }
</style>
